{
  "name": "dsh-lan-link",
  "version": "0.3.0",
  "description": "Give this harness process LAN access: publish its authenticated launch links to <harness home>/lan-link.txt (and DSH_LAN_LINK), and optionally serve devices directly on a fixed LAN port — the session is held locally, so a device needs no token.",
  "license": "MIT",
  "author": "sqzw-x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqzw-x/dsh-plugins.git",
    "directory": "packages/dsh-lan-link"
  },
  "homepage": "https://github.com/sqzw-x/dsh-plugins/tree/main/packages/dsh-lan-link#readme",
  "bugs": {
    "url": "https://github.com/sqzw-x/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./gateway": {
      "types": "./lib/gateway.d.ts",
      "default": "./lib/gateway.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "npm run build && node --test test/*.test.ts",
    "smoke": "npm run build && node scripts/live-smoke.ts",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm run test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lan",
    "remote",
    "launch-token",
    "mobile",
    "reverse-proxy",
    "websocket",
    "局域网",
    "远程访问",
    "手机访问",
    "反向代理"
  ],
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dsh-plugin-toolkit": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
