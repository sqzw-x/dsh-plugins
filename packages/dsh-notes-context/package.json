{
  "name": "dsh-notes-context",
  "version": "0.2.1",
  "description": "Notes-backed context compression for DeepSeek Harness: replace LLM-summarized compaction with a model-written persistent notebook plus recoverable raw history — the rollover boundary itself costs zero model calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqzw-x/dsh-plugins.git",
    "directory": "packages/dsh-notes-context"
  },
  "homepage": "https://github.com/sqzw-x/dsh-plugins/tree/main/packages/dsh-notes-context#readme",
  "bugs": {
    "url": "https://github.com/sqzw-x/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "notes",
    "notebook",
    "context-window",
    "rollover"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "npm run build && node --test test/*.test.ts",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cosmokit": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-compaction": "catalog:",
    "@deepseek-ai/dsh-compaction-basic": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-token-meter": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "dsh-plugin-toolkit": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
