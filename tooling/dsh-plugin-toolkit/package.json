{
  "name": "dsh-plugin-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared build and test plumbing for the plugins in this repository: one tsdown preset, one set of harness test doubles.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tsdown": {
      "types": "./src/tsdown.ts",
      "default": "./src/tsdown.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "default": "./src/test.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "tsdown": ">=0.23.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  }
}
